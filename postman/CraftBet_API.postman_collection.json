    {
      "name": "Payments & transactions",
      "description": "Deposits, withdrawals, transaction history, payment methods.",
      "item": [
        {
          "name": "05. Deposit information (GetPaymentRequests Type=2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{siteUrl}}"
              },
              {
                "key": "Referer",
                "value": "{{siteUrl}}/"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{partnerId}}/api/Main/ApiRequest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{partnerId}}",
                "api",
                "Main",
                "ApiRequest"
              ]
            },
            "description": "Deposit requests of the client for the last 30 days. Type 2 = deposit.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Controller\": \"Document\",\n  \"Method\": \"GetPaymentRequests\",\n  \"PartnerId\": {{partnerId}},\n  \"LanguageId\": \"{{languageId}}\",\n  \"TimeZone\": {{timeZone}},\n  \"Token\": \"{{token}}\",\n  \"ClientId\": {{clientId}},\n  \"RequestData\": \"{\\\"ClientId\\\":{{clientId}},\\\"TimeZone\\\":{{timeZone}},\\\"CurrencyId\\\":\\\"{{currencyId}}\\\",\\\"CreatedFrom\\\":\\\"{{createdFrom}}\\\",\\\"CreatedBefore\\\":\\\"{{createdBefore}}\\\",\\\"SkipCount\\\":0,\\\"TakeCount\\\":20,\\\"Statuses\\\":null,\\\"Type\\\":2}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Client data requires an authenticated session token (see README: Postman / How to get a token)",
                  "if (!pm.environment.get('token') || !pm.environment.get('clientId')) {",
                  "    console.warn('token / clientId are empty - request skipped');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const ro = json.ResponseObject;",
                  "// The API wraps lists differently per method - accept the known shapes",
                  "const list = Array.isArray(ro) ? ro",
                  "    : (ro && (ro.PaymentRequests || ro.Transactions || ro.Bets || ro.Entities || ro.Bonuses || ro.Documents)) || [];",
                  "",
                  "pm.test('ResponseObject is returned', () => pm.expect(ro).to.not.be.undefined);",
                  "pm.test('All items are deposits of this client', () => {",
                  "    list.forEach(p => {",
                  "        if (p.Type !== undefined) pm.expect(p.Type).to.eql(2);",
                  "        if (p.ClientId !== undefined) pm.expect(String(p.ClientId)).to.eql(String(pm.environment.get('clientId')));",
                  "    });",
                  "});"
                ]
              }
            }
          ],
