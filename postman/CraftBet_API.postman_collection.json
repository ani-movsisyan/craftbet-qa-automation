{
  "info": {
    "_postman_id": "d51da19e-fd63-5d6f-b370-67e6a4d4fcc3",
    "name": "CraftBet API - data retrieval",
    "description": "Read-only requests to the CraftBet website API (`websitewebapi.craftbet.com`).\n\nThe platform exposes an RPC-style API: most read operations are `POST` requests whose body names the `Controller` and `Method` (e.g. `Document/GetBetsHistory`). Only `Get*` methods are used here - nothing creates, changes or deletes data.\n\nAuthentication: the website encrypts credentials client-side (RSA) before `LoginClient`, so the collection works with a session token instead. Put it into the `token` environment variable (see README) and run `00. Validate session` first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Rolling 30-day period used by all history requests",
          "const now = new Date();",
          "const from = new Date(now.getTime() - 30 * 24 * 3600 * 1000);",
          "pm.collectionVariables.set('createdFrom', from.toISOString().slice(0, 19));",
          "pm.collectionVariables.set('createdBefore', new Date(now.getTime() + 24 * 3600 * 1000).toISOString().slice(0, 19));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ---- common validations for every request ----",
          "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Response time is below 5s', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
          "pm.test('Response is JSON', () => pm.response.to.be.json);",
          "const body = pm.response.json();",
          "pm.test('Platform ResponseCode is 0 (success)', () => {",
          "    pm.expect(body.ResponseCode, `Description: ${body.Description}`).to.eql(0);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "createdFrom",
      "value": ""
    },
    {
      "key": "createdBefore",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public data (no session)",
      "description": "Catalogue data available to any visitor.",
      "item": [
        {
          "name": "11. Game information - search (GetGames)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{siteUrl}}"
              },
              {
                "key": "Referer",
                "value": "{{siteUrl}}/"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{partnerId}}/api/Main/GetGames",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{partnerId}}",
                "api",
                "Main",
                "GetGames"
              ]
            },
            "description": "Public catalogue search: games whose name matches `{{gamePattern}}`. Does not require a session.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"PartnerId\": {{partnerId}},\n  \"TimeZone\": {{timeZone}},\n  \"LanguageId\": \"{{languageId}}\",\n  \"Method\": \"GetGames\",\n  \"CategoryId\": null,\n  \"PageIndex\": 0,\n  \"PageSize\": 24,\n  \"ProviderIds\": [],\n  \"CategoryIds\": [\n    1,\n    0,\n    24,\n    21,\n    26,\n    12,\n    25,\n    13,\n    9,\n    6,\n    19,\n    8,\n    4,\n    16,\n    3,\n    2,\n    10,\n    22\n  ],\n  \"Pattern\": \"{{gamePattern}}\",\n  \"RequestData\": \"{\\\"Pattern\\\": \\\"{{gamePattern}}\\\", \\\"ProviderIds\\\": [], \\\"CategoryId\\\": null, \\\"PageIndex\\\": 0, \\\"PageSize\\\": 24, \\\"CategoryIds\\\": [1, 0, 24, 21, 26, 12, 25, 13, 9, 6, 19, 8, 4, 16, 3, 2, 10, 22]}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const games = pm.response.json().ResponseObject.Games;",
                  "const pattern = pm.environment.get('gamePattern').toLowerCase();",
                  "pm.test('Games are found', () => pm.expect(games).to.be.an('array').that.is.not.empty);",
                  "pm.test('Page size is respected (<= 24)', () => pm.expect(games.length).to.be.at.most(24));",
                  "pm.test('Every game name contains the search pattern', () => games.forEach(g => pm.expect(g.n.toLowerCase()).to.include(pattern)));",
                  "pm.test('Every game has id, provider and image', () => games.forEach(g => {",
                  "    pm.expect(g.p).to.be.a('number');",
                  "    pm.expect(g.sp).to.be.a('string').and.not.empty;",
                  "    pm.expect(g.i).to.be.a('string').and.not.empty;",
                  "}));",
                  "pm.environment.set('sampleGameId', games[0].p);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "12. Game providers (GetGameProviders)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{siteUrl}}"
              },
              {
                "key": "Referer",
                "value": "{{siteUrl}}/"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{partnerId}}/api/Main/GetGameProviders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{partnerId}}",
                "api",
                "Main",
                "GetGameProviders"
              ]
            },
            "description": "Public list of game providers with the number of games for each.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"PartnerId\": {{partnerId}},\n  \"LanguageId\": \"{{languageId}}\",\n  \"TimeZone\": {{timeZone}}\n}",
              "options": {
